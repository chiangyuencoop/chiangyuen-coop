rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{document=**} {
      allow read: if true;
      allow write: if true; // allow admin operations
    }
    match /personnel/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /news/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }
    match /inquiries/{document=**} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
